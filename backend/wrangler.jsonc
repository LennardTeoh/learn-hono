{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumiere-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
"vars": {
  "CORS_ORIGIN": "https://lumiere-bpk.pages.dev",
  "APP_ORIGIN": "https://lumiere-bpk.pages.dev",
  "BETTER_AUTH_URL": "https://lumiere-api.p22014454.workers.dev",
  "EMAIL_FROM": "lumiere.csproject@gmail.com"
},
  "d1_databases": [
    {
      // This matches the c.env.DB binding in your orders.ts file
      "binding": "DB",
      "database_name": "lumiere-db",
      "database_id": "eae92745-8c51-42eb-bdd5-af055ada0710" // Replace this with your actual Cloudflare D1 ID if it was lost
    }
  ]
}