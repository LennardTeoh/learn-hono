{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petitbakery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://petitbakery.pages.dev",
    "CORS_ORIGIN": "https://petitbakery.pages.dev",
    "EMAIL_FROM": "PetitBakery <noreply@your-domain.example>",
    "SESSION_TTL_SECONDS": "604800",
    "PBKDF2_ITERATIONS": "600000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petitbakery-db",
      "database_id": "5f96f9c6-4309-4412-9dbd-05662419517f"
    }
  ]
}
