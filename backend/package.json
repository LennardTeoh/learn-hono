{
  "name": "nimble-commerce-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply nimble-shop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nimble-shop-db --remote",
    "db:seed:local": "wrangler d1 execute nimble-shop-db --local --file=./migrations/0002_seed_products.sql"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.92.0"
  }
}
