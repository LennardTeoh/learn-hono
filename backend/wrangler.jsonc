{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumiere-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://lumiere-bpk.pages.dev",
    "CORS_ORIGIN": "https://lumiere-bpk.pages.dev",
    "BETTER_AUTH_URL": "https://lumiere-api.p22014454.workers.dev/api/auth",
    "EMAIL_FROM": "lumiere.csproject@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumiere-db",
      "database_id": "7e8a8b3d-0a52-493e-b752-f5d1167195e9"
    }
  ]
  
  
}
