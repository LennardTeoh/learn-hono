{
  "name": "nimble-commerce-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file=../.env",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply petitbakery-db --local",
    "db:clean:e2e": "wrangler d1 execute petitbakery-db --local --file=./migrations/e2e_cleanup.sql",
    "db:migrate:remote": "wrangler d1 migrations apply petitbakery-db --remote",
    "db:seed:local": "wrangler d1 execute petitbakery-db --local --file=./migrations/0002_seed_products.sql"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.92.0"
  }
}
